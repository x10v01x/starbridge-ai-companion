<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="星桥 AI · WorkBuddy 助手" Width="1360" Height="900" MinWidth="1000" MinHeight="700" WindowStartupLocation="CenterScreen" Background="#F3F7FC" FontFamily="Microsoft YaHei UI" FontSize="14">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Background" Value="#1768ED"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="20,12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value=".85"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#71839E"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
 </Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#EAF2FC"><Grid Margin="16,32,16,24"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><Grid Margin="8,0,0,38"><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Name="BrandIcon" Width="42" Height="42" HorizontalAlignment="Left" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Name="BrandName" Text="星桥 AI" FontSize="22" FontWeight="Bold" Foreground="#102345"/><TextBlock Text="连接更多 AI 模型" Style="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel></Grid>
    <Button Name="HomeButton" Background="#D9E8FD" Foreground="#1768ED" HorizontalContentAlignment="Stretch" Padding="16,0" Height="48" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Name="IconDashboard" Width="24" Height="24" HorizontalAlignment="Left"/><TextBlock Grid.Column="1" Text="工作台" VerticalAlignment="Center"/></Grid></Button>
    <Button Name="WebButton" Background="Transparent" Foreground="#233A5C" HorizontalContentAlignment="Stretch" Padding="16,0" Height="48" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Name="IconWallet" Width="24" Height="24" HorizontalAlignment="Left"/><TextBlock Grid.Column="1" Text="账户与充值" VerticalAlignment="Center"/></Grid></Button>
    <Button Name="HelpButton" Background="Transparent" Foreground="#233A5C" HorizontalContentAlignment="Stretch" Padding="16,0" Height="48"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Name="IconHelp" Width="24" Height="24" HorizontalAlignment="Left"/><TextBlock Grid.Column="1" Text="使用帮助" VerticalAlignment="Center"/></Grid></Button>
   </StackPanel><StackPanel Grid.Row="1" Margin="12,0"><TextBlock Text="一个账号，一份余额" Foreground="#647997" FontSize="12"/><TextBlock Text="积分数据自动同步" Foreground="#91A1B8" FontSize="11" Margin="0,6,0,0"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Column="1" Margin="24,30,24,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Name="Greeting" Text="我的工作台" FontSize="29" FontWeight="Bold" Foreground="#0E2041"/><TextBlock Text="连接 AI 模型，让 WorkBuddy 拥有更多可能。" Foreground="#526986" FontSize="14" Margin="0,9,0,0"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><TextBlock Text="服务地址" Foreground="#526986" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox Name="PortalUrl" Width="300" Padding="8,6" ToolTip="兼容星桥助手协议的 HTTPS 门户地址"/><Button Name="PortalApplyButton" Content="保存地址" Background="#E8F0FB" Foreground="#28466E" Padding="10,6" Margin="8,0,0,0"/></StackPanel></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Name="LoginButton" Content="浏览器登录 ↗"/><StackPanel Name="AccountInfo" Visibility="Collapsed" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#E0ECFD" CornerRadius="18" Width="36" Height="36" Margin="0,0,9,0"><TextBlock Name="AccountAvatar" Text="•" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Foreground="#1768ED"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="当前账号" Foreground="#71839E" FontSize="11"/><TextBlock Name="AccountName" Text="—" MaxWidth="150" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Foreground="#102345"/></StackPanel></StackPanel><Button Name="LogoutButton" Content="退出账户" Visibility="Collapsed" Background="#E8F0FB" Foreground="#28466E" Margin="14,0,0,0"/></StackPanel></Grid>
   <Border Name="WalletCard" Grid.Row="1" Background="White" BorderBrush="#DFE8F3" BorderThickness="1" CornerRadius="12" Padding="22,18" Margin="0,24,0,18"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#EFF5FD" CornerRadius="15" Width="48" Height="48" VerticalAlignment="Top"><Image Name="MetricWallet" Width="32" Height="32"/></Border><StackPanel Grid.Column="1"><TextBlock Text="账户余额" Foreground="#526986"/><StackPanel Orientation="Horizontal"><TextBlock Name="Balance" Text="—" FontSize="30" FontWeight="Bold" Foreground="#1768ED"/><TextBlock Text=" 积分" VerticalAlignment="Bottom" Margin="0,0,0,6"/></StackPanel></StackPanel></Grid>
    <Border Grid.Column="1" BorderBrush="#EDF1F6" BorderThickness="1,0,0,0" Padding="20,0,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#EFF5FD" CornerRadius="15" Width="48" Height="48" VerticalAlignment="Top"><Image Name="MetricUsage" Width="32" Height="32"/></Border><StackPanel Grid.Column="1"><TextBlock Text="累计消耗" Foreground="#526986"/><TextBlock Name="Used" Text="— 积分" FontSize="23" FontWeight="Bold" Foreground="#102345" Margin="0,5,0,0"/></StackPanel></Grid></Border>
    <Border Grid.Column="2" BorderBrush="#EDF1F6" BorderThickness="1,0,0,0" Padding="20,0,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#EFF5FD" CornerRadius="15" Width="48" Height="48" VerticalAlignment="Top"><Image Name="MetricRequests" Width="32" Height="32"/></Border><StackPanel Grid.Column="1"><TextBlock Text="调用次数" Foreground="#526986"/><TextBlock Name="Requests" Text="— 次" FontSize="23" FontWeight="Bold" Foreground="#102345" Margin="0,5,0,0"/></StackPanel></Grid></Border>
    <Border Grid.Column="3" BorderBrush="#EDF1F6" BorderThickness="1,0,0,0" Padding="20,0,0,0"><StackPanel><TextBlock Name="WalletHint" Text="登录后同步账户余额" Foreground="#526986" FontSize="12"/><Button Name="RefreshButton" Content="刷新余额 ↻" Background="#EFF5FD" Foreground="#1768ED" Padding="10,8" HorizontalAlignment="Left" Margin="0,8,0,0"/></StackPanel></Border>
    <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Text="余额会在使用后自动更新。" Style="{StaticResource Muted}" Margin="0,12,0,0"/>
   </Grid></Border>
   <Border Name="ModelsCard" Grid.Row="2" Background="White" BorderBrush="#DFE8F3" BorderThickness="1" CornerRadius="12" Padding="22,20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><StackPanel Orientation="Horizontal"><Image Name="ConnectIcon" Width="40" Height="40" Margin="0,0,10,0"/><TextBlock Text="连接 WorkBuddy" FontSize="23" FontWeight="Bold" Foreground="#102345" VerticalAlignment="Center"/></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Name="ModelCount" Text="等待登录" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Name="SyncModelsButton" Content="同步模型 ↻" Background="#ECF3FE" Foreground="#1768ED" Padding="12,8" IsEnabled="False"/></StackPanel></Grid>
    <TextBlock Grid.Row="1" Text="选择你希望在 WorkBuddy 中使用的 AI 模型，一键完成配置。" Foreground="#71839E" Margin="0,7,0,16"/>
    <Border Grid.Row="2" Background="#F2F6FB" CornerRadius="8,8,0,0" Padding="14,11"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="2.1*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><CheckBox Name="SelectAll" VerticalAlignment="Center" Margin="0,0,18,0" IsEnabled="False" ToolTip="全选模型"/><TextBlock Text="模型名称" Foreground="#60738E"/></StackPanel><TextBlock Grid.Column="1" Text="模型简介" Foreground="#60738E"/><TextBlock Grid.Column="2" Text="状态" Foreground="#60738E" HorizontalAlignment="Right"/></Grid></Border>
    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" MinHeight="95"><StackPanel Name="ModelList"><Border Background="#F9FBFE" Padding="20,25"><StackPanel><TextBlock Text="从浏览器登录开始" HorizontalAlignment="Center" Foreground="#4B5877" FontSize="16"/><TextBlock Text="登录后同步账户余额和可用模型。" TextAlignment="Center" Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></Border></StackPanel></ScrollViewer>
    <StackPanel Grid.Row="4" Margin="0,16,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="配置路径" Foreground="#233A5C" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox Name="ConfigPath" Grid.Column="1" Padding="10,9" BorderBrush="#CFDBEB" Background="White" FontSize="11" VerticalContentAlignment="Center"/><Button Name="BrowseButton" Grid.Column="2" Content="选择位置" Background="#EEF4FC" Foreground="#365579" Padding="12,10" Margin="8,0,0,0"/><Button Name="ConfigureButton" Grid.Column="3" Content="✦  一键配置" Padding="20,10" Margin="10,0,0,0"/><Button Name="RestoreButton" Grid.Column="4" Content="恢复备份" Background="#F2F7FE" Foreground="#28466E" BorderBrush="#BED5F6" BorderThickness="1" Padding="14,10" Margin="10,0,0,0"/></Grid><TextBlock Text="配置前自动备份原文件；完成后请重启 WorkBuddy。" Style="{StaticResource Muted}" Margin="70,10,0,0"/></StackPanel>
   </Grid></Border>
   <StackPanel Grid.Row="3" Margin="2,12,0,0"><TextBlock Name="Status" Text="准备就绪 · 余额每 20 秒自动同步" Foreground="#71839E" FontSize="11"/><TextBlock Name="CreditRatio" Text="按模型使用量扣除积分 · 积分不足时无法发起新调用" Style="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0"/></StackPanel>
  </Grid>
 </Grid>
</Window>
